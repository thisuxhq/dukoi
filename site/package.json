{
  "name": "@dukoi/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/markdown.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@dukoi/shared": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/turndown": "^5.0.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.160.1"
  },
  "description": "The landing page and user guide: what Dukoi is, how to install it and how to use it"
}
