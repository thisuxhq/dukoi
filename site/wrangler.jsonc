// Serves the static build at dukoi.com. See docs/decisions.md (D-112).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dukoi-site",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // The worker only redirects www, but it has to see every request to do that
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "dukoi.com", "custom_domain": true },
    { "pattern": "www.dukoi.com", "custom_domain": true }
  ]
}
