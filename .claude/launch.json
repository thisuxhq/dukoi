{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--filter",
        "@dukoi/site",
        "dev",
        "--",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "site-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "site",
        "wrangler",
        "dev",
        "--config",
        "site/wrangler.jsonc",
        "--port",
        "8787",
        "--local"
      ],
      "port": 8787
    }
  ]
}
