{
  "name": "droidhost",
  "private": true,
  "type": "module",
  "description": "Turn old Android phones into app servers.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "shared",
    "agent",
    "cli"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cli": "bun cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
